+    $form.Add_Shown({ $animationTimer.Start(); $timer.Start() })
@@
 } finally {
+    if ($animationTimer) { $animationTimer.Stop(); $animationTimer.Dispose() }
     if ($timer) { $timer.Stop(); $timer.Dispose() }
